{
    "cache": {
        "enabled": true,
        "path": "./cache.db",
        "default_ttl_seconds": 300,
        "max_size_mb": 50
    },
    "client": {
        "base_url": "https://en.cppreference.com",
        "timeout_seconds": 10,
        "rate_limit_retry_delay_ms": 1000,
        "max_retries": 3
    },
    "content": {
        "max_output_chars": 8000
    },
    "server": {
        "thread_pool_size": 10
    }
}
